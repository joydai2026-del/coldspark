{
  "name": "coldspark",
  "version": "0.1.0",
  "description": "A config-driven cold outreach engine: discover, enrich, verify, personalize, sequence, track replies, follow up, hand off.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "coldspark": "./src/cli.ts"
  },
  "scripts": {
    "demo": "tsx src/cli.ts run --industry accounting --dry-run",
    "demo:dental": "tsx src/cli.ts run --industry dental --dry-run",
    "run": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
